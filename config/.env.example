# Desktop AI Assistant — Environment Configuration
# 
# Copy this file to config/.env and fill in your API keys.
# Never commit config/.env to version control!

# Your Preferred Name (used in spoken greetings e.g. "Good morning, Ash")
USER_NAME=Ash

# Get your Groq API key (free): https://console.groq.com
# Used for ultra-fast voice transcription (Whisper) & instant Q&A
GROQ_API_KEY=your_groq_api_key_here

# Get your Gemini API key (free): https://aistudio.google.com/apikey
# Used for complex reasoning & fallback intent matching
GEMINI_API_KEY=your_gemini_api_key_here

# Mobile Remote Control Password (protects web UI at http://<your-ip>:5000)
MOBILE_APP_PASSWORD=your_mobile_password_here
