# Desktop AI Assistant — Environment Configuration
# 
# Copy this file to config/.env and fill in your API keys.
# Never commit config/.env to version control!
#
# Get your Groq API key (free): https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get your Gemini API key (free): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
